; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited safely using a text editor.

config_version=5

[application]

config/name="Club Budget: The Game"
config/description="A resource management and math club simulation game."
config/version="1.0.0"
config/features=PackedStringArray("4.7", "Compatibility")
run/main_scene="res://scenes/main.tscn"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
